nextflow_workflow {

    name "Test Subworkflow MERGE_FAMILIES"
    script "../main.nf"
    workflow "MERGE_FAMILIES"

    test("fasta") {

        when {
            workflow {
                """
                def similarities_content = "family_1,family_2,similarity_score\\nmgnifams_test_1,mgnifams_test_2,0.94\\n"

                def similarities_file = file('similarities.csv')
                similarities_file.text = similarities_content

                input[0] = [
                    [ id: 'mgnifams_test' ],
                    similarities_file
                ]
                input[1] = channel.of([
                    [ id: 'mgnifams_test' ],
                    [
                        file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_1.aln', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_2.aln', checkIfExists: true)
                    ]
                ])
                input[2] = channel.of([
                    [ id: 'mgnifams_test', pool: 'create' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[3] = "standard" // family_generation_algorithm
                input[4] = "famsa"    // alignment_tool
                input[5] = false      // skip_seed_msa_trimming
                input[6] = false      // hmmsearch_write_target
                input[7] = true       // hmmsearch_write_domain
                input[8] = false      // skip_additional_sequence_recruiting
                input[9] = 0.9       // hmmsearch_query_length_threshold
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    file(workflow.out.hmm[0][1]).name,
                    workflow.out.seed_msa,
                    workflow.out.full_msa,
                    workflow.out.fasta
                ).match()}
            )
        }
    }

    test("pool with an updated family - recruits from the update pool") {
        // 'fam_x' is an updated family (not named '<id>_<digit>...'): the merge recruits from the
        // update pool only, and the merged name lists created numbers before updated names
        when {
            workflow {
                """
                def similarities_file = file('similarities_updated.csv')
                similarities_file.text = "family_1,family_2,similarity_score\\nmgnifams_test_1,fam_x,0.94\\n"
                def updated_seed = file('fam_x.aln')
                file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_2.aln', checkIfExists: true).copyTo(updated_seed)

                input[0] = [ [ id: 'mgnifams_test' ], similarities_file ]
                input[1] = channel.of([
                    [ id: 'mgnifams_test' ],
                    [
                        file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_1.aln', checkIfExists: true),
                        updated_seed
                    ]
                ])
                input[2] = channel.of([
                    [ id: 'mgnifams_test', pool: 'update' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[3] = "standard" // family_generation_algorithm
                input[4] = "famsa"    // alignment_tool
                input[5] = false      // skip_seed_msa_trimming
                input[6] = false      // hmmsearch_write_target
                input[7] = true       // hmmsearch_write_domain
                input[8] = false      // skip_additional_sequence_recruiting
                input[9] = 0.9        // hmmsearch_query_length_threshold
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.full_msa.collect { meta, msa -> [meta.merged_id, meta.pool, file(msa).name] } == [['mgnifams_test_1_fam_x', 'update', 'mgnifams_test_1_fam_x.sto.gz']] }
            )
        }
    }

    test("large pool - merged_id stays within filename length limit") {
        // Regression test for the 'OSError: [Errno 36] File name too long' crash in MERGE_SEEDS
        // when a pool combines many families. The two real seed MSAs are duplicated under 90
        // distinct family names (headers made unique) and chained into a single connected
        // component, so merged_id would exceed the filesystem's name limit unless it collapses
        // to the bounded hash form.
        when {
            workflow {
                """
                def n = 90
                def fams = (1..n).collect { "mgnifams_test_\${it}" }

                // Reuse the existing fixtures, alternating between the two
                def alns = [
                    file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_1.aln', checkIfExists: true).text,
                    file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_2.aln', checkIfExists: true).text
                ]
                def seedFiles = fams.withIndex().collect { fam, i ->
                    def f = file("\${fam}.aln")
                    // Prefix every header with the family id so the merged seed has unique names
                    f.text = alns[i % 2].replaceAll(/(?m)^>/, ">\${fam}_")
                    f
                }

                // Chain the families into one connected component (transitive closure -> one pool)
                def rows = (0..<n - 1).collect { "\${fams[it]},\${fams[it + 1]},0.94" }.join('\\n')
                def similarities_file = file('similarities_large_pool.csv')
                similarities_file.text = "family_1,family_2,similarity_score\\n" + rows + "\\n"

                input[0] = [ [ id: 'mgnifams_test' ], similarities_file ]
                input[1] = channel.of([ [ id: 'mgnifams_test' ], seedFiles ])
                input[2] = channel.of([
                    [ id: 'mgnifams_test', pool: 'create' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[3] = "standard" // family_generation_algorithm
                input[4] = "famsa"    // alignment_tool
                input[5] = false      // skip_seed_msa_trimming
                input[6] = false      // hmmsearch_write_target
                input[7] = true       // hmmsearch_write_domain
                input[8] = false      // skip_additional_sequence_recruiting
                input[9] = 0.9       // hmmsearch_query_length_threshold
                """
            }
        }

        then {
            def merged_name = file(workflow.out.hmm[0][1]).name
            assertAll(
                // No 'File name too long' crash in MERGE_SEEDS
                { assert workflow.success },
                { assert snapshot(
                    // merged_id collapsed to the bounded hash form instead of a 200+ char name
                    merged_name,
                    merged_name ==~ /mgnifams_test_\d+fams_[0-9a-f]{10}\.hmm.gz/,
                    merged_name.length() < 200,
                    workflow.out.seed_msa,
                    workflow.out.full_msa,
                    workflow.out.fasta
                ).match()}
            )
        }
    }

    test("two samples - each pool merges its own sample's seeds") {
        // Regression test for MERGE_SEEDS receiving the first sample's seed MSAs for every
        // sample. It only manifests with >= 2 samples: with a single sample the first
        // emission of the seed channel and the sample's own seeds are the same item.
        // Both samples reuse the two real fixtures, but under sample-scoped file names and
        // with sample-scoped sequence headers, so a mispaired seed collection is visible
        // twice over: merge_seeds.py finds no alignment for the requested families and the
        // process fails on its missing output, and any merged seed that did get written
        // would carry the wrong sample's headers.
        when {
            workflow {
                """
                def alns = [
                    file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_1.aln', checkIfExists: true).text,
                    file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_2.aln', checkIfExists: true).text
                ]

                def samples = [ 'sampleA', 'sampleB' ]
                def sequences = file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)

                // Per sample: two seed files named '<sample>_<n>.aln', headers prefixed with the
                // sample id so the merged seed's contents identify which sample they came from.
                def seed_input = samples.collect { sample ->
                    def seedFiles = (1..2).collect { n ->
                        def f = file("\${sample}_\${n}.aln")
                        f.text = alns[n - 1].replaceAll(/(?m)^>/, ">\${sample}_")
                        f
                    }
                    [ [ id: sample ], seedFiles ]
                }

                // One pool per sample, joining that sample's two families
                def similarities_input = samples.collect { sample ->
                    def f = file("similarities_\${sample}.csv")
                    f.text = "family_1,family_2,similarity_score\\n\${sample}_1,\${sample}_2,0.94\\n"
                    [ [ id: sample ], f ]
                }

                input[0] = channel.fromList(similarities_input)
                input[1] = channel.fromList(seed_input)
                input[2] = channel.fromList(samples.collect { sample -> [ [ id: sample, pool: 'create' ], sequences ] })
                input[3] = "standard" // family_generation_algorithm
                input[4] = "famsa"    // alignment_tool
                input[5] = false      // skip_seed_msa_trimming
                input[6] = false      // hmmsearch_write_target
                input[7] = true       // hmmsearch_write_domain
                input[8] = false      // skip_additional_sequence_recruiting
                input[9] = 0.9       // hmmsearch_query_length_threshold
                """
            }
        }

        then {
            // Merged output of each sample, keyed by the sample it should have come from
            def seedsBySample = workflow.out.seed_msa.collectEntries { meta, msa -> [ (meta.id): file(msa) ] }
            assertAll(
                // Pre-fix, sampleB's pool was handed sampleA's seed files, so MERGE_SEEDS
                // wrote no merged seed for sampleB and the task failed on its missing output.
                { assert workflow.success },
                { assert seedsBySample.keySet() == ['sampleA', 'sampleB'] as Set },
                // Each merged seed carries only its own sample's sequences
                { assert seedsBySample.sampleA.text.contains('>sampleA_') },
                { assert !seedsBySample.sampleA.text.contains('>sampleB_') },
                { assert seedsBySample.sampleB.text.contains('>sampleB_') },
                { assert !seedsBySample.sampleB.text.contains('>sampleA_') },
                // Sorted by sample id: the two samples run concurrently, so channel emission
                // order is not stable across runs.
                { assert snapshot(
                    workflow.out.hmm.collect { meta, hmm -> file(hmm).name }.sort(),
                    workflow.out.seed_msa.sort { entry -> entry[0].id },
                    workflow.out.full_msa.sort { entry -> entry[0].id },
                    workflow.out.fasta.sort { entry -> entry[0].id }
                ).match()}
            )
        }
    }

    test("multiple pools - each MERGE_SEEDS task stages only its pool's seeds") {
        // Regression test for #191: each MERGE_SEEDS task must stage only its own pool's seeds,
        // not the whole sample. Gzipped 'test_5' covers the '.fas.gz' stem. Only the staging
        // check fails pre-fix, since merge_seeds.py ignores extra files.
        when {
            workflow {
                """
                def alns = [
                    file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_1.aln', checkIfExists: true).text,
                    file(params.pipelines_testdata_base_path + 'test_data/modules/mgnifams_test_2.aln', checkIfExists: true).text
                ]
                // Family-id header prefix traces merged sequences back to their seed
                def seedFiles = (1..4).collect { n ->
                    def f = file("test_\${n}.aln")
                    f.text = alns[n % 2].replaceAll(/(?m)^>/, ">test_\${n}_")
                    f
                }
                def gz = file('test_5.fas.gz')
                new java.util.zip.GZIPOutputStream(gz.newOutputStream()).withWriter { writer ->
                    writer << alns[1].replaceAll(/(?m)^>/, '>test_5_')
                }
                seedFiles << gz

                // Pools: {test_1, test_2}, {test_3, test_5}; test_4 unpooled
                def similarities_file = file('similarities_multiple_pools.csv')
                similarities_file.text = "family_1,family_2,similarity_score\\ntest_1,test_2,0.94\\ntest_3,test_5,0.94\\n"

                input[0] = [ [ id: 'test' ], similarities_file ]
                input[1] = channel.of([ [ id: 'test' ], seedFiles ])
                input[2] = channel.of([
                    [ id: 'test', pool: 'create' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[3] = "standard" // family_generation_algorithm
                input[4] = "famsa"    // alignment_tool
                input[5] = false      // skip_seed_msa_trimming
                input[6] = false      // hmmsearch_write_target
                input[7] = true       // hmmsearch_write_domain
                input[8] = false      // skip_additional_sequence_recruiting
                input[9] = 0.9       // hmmsearch_query_length_threshold
                """
            }
        }

        then {
            def seedsById = workflow.out.seed_msa.collectEntries { meta, msa -> [ (meta.merged_id): file(msa).text ] }
            // Staged seed names per MERGE_SEEDS task, keyed by its pool
            def stagedByPool = [:]
            new File("${launchDir}/work").eachFileRecurse(groovy.io.FileType.FILES) { script ->
                if (script.name == '.command.sh' && script.text.contains('merge_seeds.py')) {
                    def pool = (script.text =~ /--list "([^"]+)"/)[0][1]
                    stagedByPool[pool] = new File(script.parentFile, 'seed_msa').list().sort()
                }
            }
            assertAll(
                { assert workflow.success },
                { assert seedsById.keySet() == ['test_1_2', 'test_3_5'] as Set },
                { assert seedsById.test_1_2.contains('>test_1_') && seedsById.test_1_2.contains('>test_2_') },
                { assert !(seedsById.test_1_2 =~ />test_[345]_/) },
                // '>test_5_': gzipped seed survived the filter
                { assert seedsById.test_3_5.contains('>test_3_') && seedsById.test_3_5.contains('>test_5_') },
                { assert !(seedsById.test_3_5 =~ />test_[124]_/) },
                // Pre-fix: every task staged all five seeds
                { assert stagedByPool == [
                    'test_1,test_2': ['test_1.aln', 'test_2.aln'],
                    'test_3,test_5': ['test_3.aln', 'test_5.fas.gz']
                ] },
                // Sorted: pools run concurrently, so emission order is unstable
                { assert snapshot(
                    workflow.out.hmm.collect { meta, hmm -> file(hmm).name }.sort(),
                    workflow.out.seed_msa.sort { entry -> entry[0].merged_id },
                    workflow.out.full_msa.sort { entry -> entry[0].merged_id },
                    workflow.out.fasta.sort { entry -> entry[0].merged_id }
                ).match()}
            )
        }
    }

}
