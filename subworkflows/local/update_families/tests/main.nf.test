nextflow_workflow {

    name "Test Subworkflow UPDATE_FAMILIES"
    script "../main.nf"
    workflow "UPDATE_FAMILIES"
    config "./nextflow.config"

    test("fasta - hmm + seed + full") {
        // Existing full MSA members are pooled with the input sequences and searched again
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id: 'test_update' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_extra.faa', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'test_data/v3/existing_hmms.tar.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'test_data/v3/existing_seed_msas.tar.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'test_data/v3/existing_full_msas.tar.gz', checkIfExists: true)
                ])
                input[1] = 0.9        // hmmsearch_query_length_threshold
                input[2] = false      // skip_sequence_redundancy_removal
                input[3] = "linclust" // clustering_tool
                input[4] = "famsa"    // alignment_tool
                input[5] = false      // skip_seed_msa_trimming
                input[6] = false      // hmmsearch_write_target
                input[7] = true       // hmmsearch_write_domain
                input[8] = false      // skip_additional_sequence_recruiting
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out.no_hit_seqs,
                    workflow.out.hmm.collect { _meta, model -> file(model).name }.sort(),
                    workflow.out.seed_msa.collect { _meta, msa -> file(msa).name }.sort(),
                    workflow.out.full_msa.collect { _meta, msa -> file(msa).name }.sort(),
                    workflow.out.fasta.collect { meta, faa -> "${meta.family}: ${path(faa).linesGzip.count { line -> line.startsWith('>') }}" }.sort(),
                    file(workflow.out.updated_family_reps[0][1]).name,
                    path(workflow.out.updated_family_reps[0][1]).readLines().size()
                ).match()}
            )
        }
    }

    test("fasta.gz - hmm only") {
        // Gzipped input, no existing MSAs: the input alone is decompressed and searched
        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id: 'test_update' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_extra.faa.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'test_data/v3/existing_hmms.tar.gz', checkIfExists: true),
                    [],
                    []
                ])
                input[1] = 0.9        // hmmsearch_query_length_threshold
                input[2] = false      // skip_sequence_redundancy_removal
                input[3] = "linclust" // clustering_tool
                input[4] = "famsa"    // alignment_tool
                input[5] = false      // skip_seed_msa_trimming
                input[6] = false      // hmmsearch_write_target
                input[7] = true       // hmmsearch_write_domain
                input[8] = false      // skip_additional_sequence_recruiting
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out.no_hit_seqs,
                    workflow.out.hmm.collect { _meta, model -> file(model).name }.sort(),
                    workflow.out.seed_msa.collect { _meta, msa -> file(msa).name }.sort(),
                    workflow.out.full_msa.collect { _meta, msa -> file(msa).name }.sort(),
                    workflow.out.fasta.collect { meta, faa -> "${meta.family}: ${path(faa).linesGzip.count { line -> line.startsWith('>') }}" }.sort(),
                    file(workflow.out.updated_family_reps[0][1]).name,
                    path(workflow.out.updated_family_reps[0][1]).readLines().size()
                ).match()}
            )
        }
    }

    test("hmm NAME mismatch - fails") {
        // fam_a.hmm is NAMEd fam_b: its hits would never meet its MSAs, so validation stops the run
        when {
            workflow {
                """
                def hmm = file('bad_hmms/hmm/fam_a.hmm')
                hmm.parent.mkdirs()
                hmm.text = 'HMMER3/f [3.4 | Aug 2023]\\nNAME  fam_b\\nLENG  1\\n//\\n'
                def archive = file('bad_hmms.tar.gz')
                ['tar', '-czf', archive.toString(), '-C', file('bad_hmms').toString(), 'hmm'].execute().waitFor()
                input[0] = channel.of([
                    [ id: 'test_update' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_extra.faa', checkIfExists: true),
                    archive,
                    [],
                    []
                ])
                input[1] = 0.9        // hmmsearch_query_length_threshold
                input[2] = false      // skip_sequence_redundancy_removal
                input[3] = "linclust" // clustering_tool
                input[4] = "famsa"    // alignment_tool
                input[5] = false      // skip_seed_msa_trimming
                input[6] = false      // hmmsearch_write_target
                input[7] = true       // hmmsearch_write_domain
                input[8] = false      // skip_additional_sequence_recruiting
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { line -> line.contains("fam_a.hmm holds NAME 'fam_b'") } }
            )
        }
    }
}
