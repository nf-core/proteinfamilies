// Subworkflow tests do not run main.nf, so the parameters that conf/modules.config reads for these steps are set here
params {
    search_evalue_cutoff               = 0.001
    seed_msa_trimming_ends_only        = true
    seed_msa_trimming_max_gap_fraction = 0.5
    seq_redundancy_cov_mode            = 0
    seq_redundancy_min_coverage        = 0.9
    seq_redundancy_min_seq_identity    = 0.9
}

process {
    withName: 'MMSEQS_CREATEDB' {
        ext.prefix = { "${meta.family}" }
    }

    withName: 'MMSEQS_LINCLUST' {
        ext.prefix = { "${meta.family}" }
        ext.args = [
            "--min-seq-id 0.9",
            "-c 0.8",
            "--cov-mode 1",
        ].join(' ').trim()
    }

    withName: 'MMSEQS_CREATETSV' {
        ext.prefix = { "${meta.family}" }
    }

    withName: 'FAMSA_ALIGN' {
        ext.prefix = { "${meta.family}" }
    }

    withName: 'CLIPKIT' {
        ext.args = [
            "-m gappy --gaps 0.5",
            "--ends_only"
        ].join(' ').trim()
        ext.prefix = { "${meta.family}" }
    }

    withName: 'RECALCULATE_COORDINATES' {
        ext.prefix = { "${meta.family}" }
    }

    withName: 'HMMER_HMMBUILD' {
        ext.prefix = { "${meta.family}" }
    }

    withName: 'HMMER_HMMSEARCH' {
        ext.args   = { "-E 0.001" }
        ext.prefix = { "${meta.id}" }
    }

    withName: '.*:GENERATE_FAMILIES:HMMER_HMMSEARCH' {
        ext.args   = { "-E 0.001" }
        ext.prefix = { "${meta.family}" }
    }

    withName: 'FILTER_RECRUITED' {
        ext.prefix = { "${meta.family}" }
    }

    withName: 'HMMER_HMMALIGN' {
        ext.prefix = { "${meta.family}" }
    }

    withName: 'HHSUITE_REFORMAT' {
        ext.prefix = { "${meta.family}" }
    }

    withName: 'REMOVE_REDUNDANT_SEQS' {
        ext.prefix = { "${meta.id}_${meta.family}" }
    }

}
