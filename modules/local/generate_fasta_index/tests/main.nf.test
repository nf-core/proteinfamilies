nextflow_process {

    name "Test Process GENERATE_FASTA_INDEX"
    script "../main.nf"
    process "GENERATE_FASTA_INDEX"

    test("proteinfamilies - fasta") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],  // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("proteinfamilies - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],  // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
