nextflow_process {

    name "Test Process POOL_EXISTING_MEMBERS"
    script "../main.nf"
    process "POOL_EXISTING_MEMBERS"

    setup {
        run("UNTAR") {
            script "../../../nf-core/untar/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + 'test_data/v3/existing_full_msas.tar.gz', checkIfExists: true)
                ])
                """
            }
        }
    }

    test("proteinfamilies - fasta - full msas") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_extra.faa.gz', checkIfExists: true)
                ])
                .join(UNTAR.out.untar)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("proteinfamilies - edge cases") {
        // seqA/10-20 is dropped (the input holds seqA), seqC/2-9 is pooled once although two MSAs hold it,
        // Stockholm blocks are joined, gaps removed and insert columns upper-cased
        when {
            process {
                """
                def fasta = file('edge.faa')
                fasta.text = '>seqA/1-50 desc\\nMKV\\n>seqB\\nAAA'
                def sto = file('f1.sto')
                sto.text = '# STOCKHOLM 1.0\\n#=GF ID f1\\nseqA/10-20 MK-v.\\nseqC/2-9   AA..c\\n#=GC RF xxxxx\\n\\nseqA/10-20 LL\\nseqC/2-9   -W\\n//\\n'
                def aln = file('f2.aln')
                aln.text = '>seqC/2-9\\nAA-C\\n>seqD\\nM-M\\n'
                input[0] = channel.of([ [ id: 'edge' ], fasta, [ sto, aln ] ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.fasta[0][1]).readLines() == ['>seqA/1-50 desc', 'MKV', '>seqB', 'AAA', '>seqC/2-9', 'AACW', '>seqD', 'MM'] }
            )
        }
    }

    test("proteinfamilies - fasta - full msas - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_extra.faa.gz', checkIfExists: true)
                ])
                .join(UNTAR.out.untar)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
