nextflow_process {

    name "Test Process CHUNK_CLUSTERS"
    script "../main.nf"
    process "CHUNK_CLUSTERS"

    test("proteinfamilies - tsv") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test_tsv' ], // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/modules/clustering.tsv', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [ id: 'test_fasta' ], // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[2] = 5
                input[3] = 'fasta'
                input[4] = 1000
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.fasta_chunks,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                    ).match()}
            )
        }
    }

    test("proteinfamilies - tsv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test_tsv' ], // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/modules/clustering.tsv', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [ id: 'test_fasta' ], // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[2] = 5
                input[3] = 'fasta'
                input[4] = 1000
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("proteinfamilies - tsv - cluster_chunks") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test_tsv' ], // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/modules/clustering.tsv', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [ id: 'test_fasta' ], // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[2] = 5
                input[3] = 'tsv'
                input[4] = 2  // small enough to split the surviving clusters over several chunks
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fasta_chunks.size() == 0 },
                { assert snapshot(
                    process.out.cluster_chunks,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                    ).match()}
            )
        }
    }

    test("proteinfamilies - tsv - cluster_chunks - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test_tsv' ], // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/modules/clustering.tsv', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [ id: 'test_fasta' ], // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[2] = 5
                input[3] = 'tsv'
                input[4] = 2
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }
}
