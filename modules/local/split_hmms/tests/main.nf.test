nextflow_process {

    name "Test Process SPLIT_HMMS"
    script "../main.nf"
    process "SPLIT_HMMS"

    test("proteinfamilies - tar.gz - hmms") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'archive' ],
                    file(params.pipelines_testdata_base_path + 'test_data/v3/existing_hmms.tar.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("proteinfamilies - plain multi-model library - hmms") {
        // models are named by NAME, not by the library's file name
        when {
            process {
                """
                def library = file('library.hmm')
                library.text = 'HMMER3/f [3.4]\\nNAME  fam_b\\nLENG  1\\n//\\nHMMER3/f [3.4]\\nNAME  fam_a\\nLENG  2\\n//\\n'
                input[0] = channel.of([ [ id: 'library' ], library ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("proteinfamilies - duplicate NAME - fails") {

        when {
            process {
                """
                def library = file('duplicate.hmm')
                library.text = 'HMMER3/f [3.4]\\nNAME  fam_a\\n//\\nHMMER3/f [3.4]\\nNAME  fam_a\\n//\\n'
                input[0] = channel.of([ [ id: 'duplicate' ], library ])
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("existing HMM NAME 'fam_a' is given more than once") }
            )
        }
    }

    test("proteinfamilies - NAME with a quote - fails") {

        when {
            process {
                """
                def library = file('quote.hmm')
                library.text = "HMMER3/f [3.4]\\nNAME  O'Brien\\n//\\n"
                input[0] = channel.of([ [ id: 'quote' ], library ])
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("existing HMM NAME 'O'Brien' in quote.hmm may only contain letters, digits, '.', '_' and '-'") }
            )
        }
    }

    test("proteinfamilies - tar.gz with macOS metadata - hmms") {
        // macOS tar adds AppleDouble `._<file>` members, which are skipped
        when {
            process {
                """
                def hmm = file('apple/hmm/fam_a.hmm')
                hmm.parent.mkdirs()
                hmm.text = 'HMMER3/f [3.4]\\nNAME  fam_a\\nLENG  1\\n//\\n'
                file('apple/hmm/._fam_a.hmm').bytes = java.util.Base64.getDecoder().decode('AAUWB//+') // binary, not UTF-8
                ['tar', '-czf', file('apple.tar.gz').toString(), '-C', file('apple').toString(), 'hmm'].execute().waitFor()
                input[0] = channel.of([ [ id: 'apple' ], file('apple.tar.gz') ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("proteinfamilies - tar.gz with a non-HMM member - fails") {
        // the error names the member at fault
        when {
            process {
                """
                def hmm = file('readme/hmm/fam_a.hmm')
                hmm.parent.mkdirs()
                hmm.text = 'HMMER3/f [3.4]\\nNAME  fam_a\\nLENG  1\\n//\\n'
                file('readme/hmm/README').text = 'these are my families\\n'
                ['tar', '-czf', file('readme.tar.gz').toString(), '-C', file('readme').toString(), 'hmm'].execute().waitFor()
                input[0] = channel.of([ [ id: 'readme' ], file('readme.tar.gz') ])
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("in readme.tar.gz:hmm/README is truncated or not an HMM") }
            )
        }
    }

    test("proteinfamilies - tar.gz - hmms - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'archive' ],
                    file(params.pipelines_testdata_base_path + 'test_data/v3/existing_hmms.tar.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
