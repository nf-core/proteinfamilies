nextflow_process {

    name "Test Process FILTER_RECRUITED"
    script "../main.nf"
    process "FILTER_RECRUITED"

    test("proteinfamilies - hmmsearch - fasta") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'filtering', chunk: 1 ],  // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/modules/chunk.domtbl.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[1] = 0.8
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.fasta,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                    ).match()}
            )
        }
    }

    test("proteinfamilies - hmmsearch - fasta - sliced input names") {
        // p is already a slice (p/101-110), so its hit [3, 8] is named in p's parent coordinates;
        // q is hit full-length, so it keeps its name
        when {
            process {
                """
                def fasta = file('edge.faa')
                fasta.text = '>p/101-110\\nACDEFGHIKL\\n>q\\nMNPQRSTVWY\\n>r\\nAAAAAAAAAA\\n'
                def domtbl = file('edge.domtbl.gz')
                domtbl.withOutputStream { os -> new java.util.zip.GZIPOutputStream(os).withWriter { w -> w << [
                    'p/101-110 - 10 fam1 - 5 1e-10 50.0 0.0 1 1 1e-10 1e-10 50.0 0.0 1 5 3 8 3 8 0.99 -',
                    'q - 10 fam1 - 5 1e-10 50.0 0.0 1 1 1e-10 1e-10 50.0 0.0 1 5 1 10 1 10 0.99 -'
                ].join('\\n') + '\\n' } }
                input[0] = channel.of([ [ id: 'edge' ], domtbl, fasta ])
                input[1] = 0.9
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.fasta[0][1]).linesGzip == ['>p/103-108', 'DEFGHI', '>q', 'MNPQRSTVWY'] }
            )
        }
    }

    test("proteinfamilies - hmmsearch - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'filtering', chunk: 1 ],  // meta map
                    file(params.pipelines_testdata_base_path + 'test_data/modules/chunk.domtbl.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[1] = 0.8
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }
}
