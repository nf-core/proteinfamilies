nextflow_pipeline {

    name "Test pipeline - mgnifam"
    script "../main.nf"
    tag "pipeline"
    profile "test_mgnifam"

    test("-profile test_mgnifam") {
        // This allows to also check files published with the new workflow output syntax
        options "-output-dir $outputDir"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // families/<id>/*.tar.gz: member order and timestamps vary, so their sorted member names are checked
            def archive_members = file("${params.outdir}/families").listFiles().findAll { sample -> sample.isDirectory() }.sort().collectMany { sample ->
                sample.listFiles().findAll { archive -> archive.name.endsWith('.tar.gz') }.sort().collect { archive -> "${archive.name}: ${['tar', '-tzf', archive.toString()].execute().text.readLines().sort().join(', ')}" }
            }
            // families/<id>/<id>.lib.gz: model order and HMM DATE lines vary, so its sorted model names are checked
            def library_models = file("${params.outdir}/families").listFiles().findAll { sample -> sample.isDirectory() }.sort().collectMany { sample ->
                sample.listFiles().findAll { library -> library.name.endsWith('.lib.gz') }.collect { library ->
                    "${library.name}: ${path(library.toString()).linesGzip.findAll { line -> line.startsWith('NAME ') }.collect { line -> line.tokenize()[1] }.sort().join(', ')}"
                }
            }
            assert workflow.success

            assertAll(
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_proteinfamilies_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content,
                    archive_members,
                    library_models
                ).match() }
            )
        }
    }
}
