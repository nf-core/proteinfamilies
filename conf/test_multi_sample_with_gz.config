/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/proteinfamilies -profile test_multi_sample_with_gz,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Multi-sample test profile'
    config_profile_description = 'Test dataset to check pipeline function with both fasta and fasta.gz sample inputs at the same time'

    // Input data
    input                         = params.pipelines_testdata_base_path + 'samplesheets/v3/samplesheet_multi_sample_with_gz.csv'
    // Clustering
    clustering_tool               = 'linclust'
    clustering_min_seq_identity   = 0.5
    clustering_min_coverage       = 0.9
    clustering_min_cluster_size   = 5
}
