/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/intermediates/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        enabled: params.save_intermediates,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'SEQFU_STATS_BEFORE' {
        ext.prefix = { "${meta.id}_before" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQFU_STATS_AFTER' {
        ext.prefix = { "${meta.id}_after" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:FAA_SEQFU_SEQKIT:SEQKIT_SEQ' {
        ext.args = [
            "--remove-gaps",
            "--upper-case",
            "--validate-seq",
            "--min-len ${params.min_seq_length}",
            "--max-len ${params.max_seq_length}"
        ].join(' ').trim()
        ext.prefix = "intermediate_seqkit_seq"
        publishDir = [
            path: { "${params.outdir}/intermediates/qc/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_REPLACE' {
        ext.args   = '-p "/" -r "_"'
        ext.suffix = "fasta"
        ext.prefix = "intermediate_seqkit_replace"
        publishDir = [
            path: { "${params.outdir}/intermediates/qc/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_RMDUP' {
        ext.args   = { params.deduplicate_by == 'sequence' ? "--by-seq" : '' }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPLIT_HMMS' {
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/split_hmms" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UNTAR_(SEED|FULL)_MSA' {
        publishDir = [
            path: { "${params.outdir}/intermediates/untar/msa" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CAT_HMM' {
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/hmmer/concatenated" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POOL_EXISTING_MEMBERS' {
        publishDir = [ enabled: false ] // intermediate: the input sequences plus existing full MSA members
    }

    withName: 'SPLIT_FAMILY_HITS' {
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/split_family_hits/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TAR_SEED_MSAS' {
        ext.prefix = { "${meta.id}_seed_msas" }
    }

    withName: 'TAR_FULL_MSAS' {
        ext.prefix = { "${meta.id}_full_msas" }
    }

    withName: 'TAR_FASTA' {
        ext.prefix = { "${meta.id}_fasta" }
    }

    withName: 'TAR_(SEED_MSAS|FULL_MSAS|FASTA)' {
        publishDir = [
            path: { "${params.outdir}/families/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_UNASSIGNED_SEQS' {
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/unassigned/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:FIND_CONCATENATE_HMMS' {
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/hmmer/concatenated" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:FIND_CONCATENATE_SKIP_IDS' {
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/skipped_ids" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_CREATEDB' {
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/initial_clustering/mmseqs_createdb/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:MMSEQS_FASTA_CLUSTER:MMSEQS_CREATEDB' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/update_families/mmseqs_createdb/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:MMSEQS_FASTA_CLUSTER:MMSEQS_CREATEDB' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/redundancy_clustering/mmseqs_createdb/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_CLUSTER' {
        ext.args = [
            "--min-seq-id ${params.clustering_min_seq_identity}",
            "-c ${params.clustering_min_coverage}",
            "--cov-mode ${params.clustering_cov_mode}",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/initial_clustering/mmseqs_cluster/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:MMSEQS_FASTA_CLUSTER:MMSEQS_CLUSTER' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        ext.args = [
            "--min-seq-id ${params.seq_redundancy_min_seq_identity}",
            "-c ${params.seq_redundancy_min_coverage}",
            "--cov-mode ${params.seq_redundancy_cov_mode}",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/update_families/mmseqs_cluster/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:MMSEQS_FASTA_CLUSTER:MMSEQS_CLUSTER' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        ext.args = [
            "--min-seq-id ${params.seq_redundancy_min_seq_identity}",
            "-c ${params.seq_redundancy_min_coverage}",
            "--cov-mode ${params.seq_redundancy_cov_mode}",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/redundancy_clustering/mmseqs_cluster/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_LINCLUST' {
        ext.args = [
            "--min-seq-id ${params.clustering_min_seq_identity}",
            "-c ${params.clustering_min_coverage}",
            "--cov-mode ${params.clustering_cov_mode}",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/initial_clustering/mmseqs_linclust/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:MMSEQS_FASTA_CLUSTER:MMSEQS_LINCLUST' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        ext.args = [
            "--min-seq-id ${params.seq_redundancy_min_seq_identity}",
            "-c ${params.seq_redundancy_min_coverage}",
            "--cov-mode ${params.seq_redundancy_cov_mode}",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/update_families/mmseqs_linclust/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:MMSEQS_FASTA_CLUSTER:MMSEQS_LINCLUST' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        ext.args = [
            "--min-seq-id ${params.seq_redundancy_min_seq_identity}",
            "-c ${params.seq_redundancy_min_coverage}",
            "--cov-mode ${params.seq_redundancy_cov_mode}",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/redundancy_clustering/mmseqs_linclust/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_CREATETSV' {
        publishDir = [
            path: { "${params.outdir}/clustering/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:MMSEQS_FASTA_CLUSTER:MMSEQS_CREATETSV' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/update_families/mmseqs_createtsv/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:MMSEQS_FASTA_CLUSTER:MMSEQS_CREATETSV' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/mmseqs/redundancy_clustering/mmseqs_createtsv/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CALCULATE_CLUSTER_DISTRIBUTION'{
        publishDir = [
            path: { "${params.outdir}/clustering/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHUNK_CLUSTERS' {
        publishDir = [
            path: { "${params.outdir}/intermediates/fasta/mmseqs_initial_clustering_filtered/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FAMSA_ALIGN' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/seed_msa/raw/famsa_align/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?MERGE_FAMILIES:GENERATE_FAMILIES:ALIGN_SEQUENCES:FAMSA_ALIGN' {
        ext.prefix = { "${meta.merged_id}" }
        tag = { "${meta.merged_id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/merge_families/seed_msa/raw/famsa_align/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:GENERATE_FAMILIES:ALIGN_SEQUENCES:FAMSA_ALIGN' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/seed_msa/raw/famsa_align/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:ALIGN_SEQUENCES:FAMSA_ALIGN' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/full_msa/filtered/famsa_align/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAFFT_ALIGN' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/seed_msa/raw/mafft_align/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?MERGE_FAMILIES:GENERATE_FAMILIES:ALIGN_SEQUENCES:MAFFT_ALIGN' {
        ext.prefix = { "${meta.merged_id}" }
        tag = { "${meta.merged_id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/merge_families/seed_msa/raw/mafft_align/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:GENERATE_FAMILIES:ALIGN_SEQUENCES:MAFFT_ALIGN' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/seed_msa/raw/mafft_align/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:ALIGN_SEQUENCES:MAFFT_ALIGN' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/full_msa/filtered/mafft_align/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CLIPKIT' {
        ext.args = [
            "-m gappy --gaps ${params.seed_msa_trimming_max_gap_fraction}",
            params.seed_msa_trimming_ends_only ? "--ends_only" : ''
        ].join(' ').trim()
        publishDir = [ enabled: false ] // intermediate: RECALCULATE_COORDINATES publishes the trimmed MSA
    }

    withName: 'RECALCULATE_COORDINATES' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/seed_msa/raw/trimmed/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.aln"
        ]
    }

    withName: '(.*:)?MERGE_FAMILIES:GENERATE_FAMILIES:ALIGN_SEQUENCES:RECALCULATE_COORDINATES' {
        ext.prefix = { "${meta.merged_id}" }
        tag = { "${meta.merged_id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/merge_families/seed_msa/raw/trimmed/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.aln"
        ]
    }

    withName: '.*:UPDATE_FAMILIES:GENERATE_FAMILIES:ALIGN_SEQUENCES:RECALCULATE_COORDINATES' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/seed_msa/raw/trimmed/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.aln"
        ]
    }

    withName: 'HMMER_HMMBUILD' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/hmm/raw/hmmer_hmmbuild/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.{hmm.gz}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?MERGE_FAMILIES:GENERATE_FAMILIES:HMMER_HMMBUILD' {
        ext.prefix = { "${meta.merged_id}" }
        tag = { "${meta.merged_id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/merge_families/hmm/raw/hmmer_hmmbuild/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.hmm.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:GENERATE_FAMILIES:HMMER_HMMBUILD' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/hmm/raw/hmmer_hmmbuild/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.hmm.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HMMER_HMMSEARCH' {
        ext.args   = { "-E ${params.search_evalue_cutoff}" }
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/hmmer/hmmsearch/${meta.id}/" },
            mode: params.publish_dir_mode,
            pattern: "*.domtbl.gz",
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?MERGE_FAMILIES:GENERATE_FAMILIES:HMMER_HMMSEARCH' {
        ext.args   = { "-E ${params.search_evalue_cutoff}" }
        ext.prefix = { "${meta.merged_id}" }
        tag = { "${meta.merged_id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/merge_families/hmmer/hmmsearch/${meta.id}/" },
            mode: params.publish_dir_mode,
            pattern: "*.{domtbl.gz}",
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:GENERATE_FAMILIES:HMMER_HMMSEARCH' {
        ext.args   = { "-E ${params.search_evalue_cutoff}" }
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/hmmer/hmmsearch/${meta.id}/" },
            mode: params.publish_dir_mode,
            pattern: "*.{domtbl.gz}",
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:HMMER_HMMSEARCH' {
        ext.args   = { "-E ${params.search_evalue_cutoff}" }
        ext.prefix = { "${meta.id}" }
        tag = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/hmmer/hmmsearch/${meta.id}/" },
            mode: params.publish_dir_mode,
            pattern: "*.{domtbl.gz}",
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:HMMER_HMMSEARCH' {
        ext.args   = { "-E ${params.search_evalue_cutoff}" }
        ext.prefix = { "${meta.id}" }
        tag = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/hmmer/hmmsearch/${meta.id}/" },
            mode: params.publish_dir_mode,
            pattern: "*.{domtbl.gz}",
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_RECRUITED' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/fasta/hmmsearch_filtered_recruited/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?MERGE_FAMILIES:GENERATE_FAMILIES:FILTER_RECRUITED' {
        ext.prefix = { "${meta.merged_id}" }
        tag = { "${meta.merged_id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/merge_families/fasta/hmmsearch_filtered_recruited/${meta.id}/" },
