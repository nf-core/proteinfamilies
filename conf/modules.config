            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:GENERATE_FAMILIES:FILTER_RECRUITED' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/fasta/hmmsearch_filtered_recruited/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HMMER_HMMALIGN' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/full_msa/raw/hmmer_hmmalign/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.sto.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?MERGE_FAMILIES:GENERATE_FAMILIES:HMMER_HMMALIGN' {
        ext.prefix = { "${meta.merged_id}" }
        tag = { "${meta.merged_id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/merge_families/full_msa/raw/hmmer_hmmalign/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.sto.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:GENERATE_FAMILIES:HMMER_HMMALIGN' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/full_msa/raw/hmmer_hmmalign/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.sto.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:HMMER_HMMALIGN' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/update_families/full_msa/raw/hmmer_hmmalign/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            pattern: "*.sto.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:(GENERATE_FAMILIES_ITERATIVELY|UPDATE_FAMILIES):GUNZIP' {
        publishDir = [ enabled: false ] // only staged for tools that cannot search a gzip stream
    }

    withName: 'HMMER_ESLSFETCHINDEX' {
        publishDir = [ enabled: false ] // scratch index for mgnifam, cheap to regenerate, not a pipeline result
    }

    withName: 'MGNIFAM_GENERATEFAMILIES' {
        ext.args   = [
            "--discard_min_rep_length ${params.min_seq_length}",
            "--discard_max_rep_length ${params.max_seq_length}",
            "--max_seq_identity ${params.seq_redundancy_min_seq_identity}",
            "--max_gap_occupancy ${params.seed_msa_trimming_max_gap_fraction}",
            "--recruit_evalue_cutoff ${params.search_evalue_cutoff}",
            "--recruit_hit_length_percentage ${params.recruit_min_model_coverage}"
        ].join(' ').trim()
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag        = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            [
                path: "${params.outdir}/intermediates/full_msa/raw/mgnifam",
                mode: params.publish_dir_mode,
                enabled: params.save_intermediates,
                pattern: "*/full_msa/*",
                saveAs: { filename -> filename ? "${meta.id}/${filename.tokenize('/').last()}" : null }
            ],
            [
                path: "${params.outdir}/intermediates/hmm/raw/mgnifam",
                mode: params.publish_dir_mode,
                enabled: params.save_intermediates,
                pattern: "*/hmm/*",
                saveAs: { filename -> filename ? "${meta.id}/${filename.tokenize('/').last()}" : null }
            ],
            [
                path: "${params.outdir}/intermediates/generate_families_iteratively",
                mode: params.publish_dir_mode,
                enabled: params.save_intermediates,
                pattern: "*/*.*",
                saveAs: { filename -> filename ? "${meta.id}/${filename}" : null }
            ],
            [
                path: "${params.outdir}/intermediates/generate_families_iteratively",
                mode: params.publish_dir_mode,
                enabled: params.save_intermediates,
                pattern: "*/rf/*",
                saveAs: { filename -> filename ? "${meta.id}/${filename}" : null }
            ]
        ]
    }

    withName: '(.*:)?MERGE_FAMILIES:GENERATE_FAMILIES_ITERATIVELY:MGNIFAM_GENERATEFAMILIES' {
        ext.prefix = { "${meta.merged_id}" }
        tag        = { "${meta.merged_id}" }
        publishDir = [
            [
                path: "${params.outdir}/intermediates/remove_redundancy/merge_families/full_msa/raw/mgnifam",
                mode: params.publish_dir_mode,
                enabled: params.save_intermediates,
                pattern: "*/full_msa/*",
                saveAs: { filename -> filename ? "${meta.id}/${filename.tokenize('/').last()}" : null }
            ],
            [
                path: "${params.outdir}/intermediates/remove_redundancy/merge_families/hmm/raw/mgnifam",
                mode: params.publish_dir_mode,
                enabled: params.save_intermediates,
                pattern: "*/hmm/*",
                saveAs: { filename -> filename ? "${meta.id}/${filename.tokenize('/').last()}" : null }
            ],
            [
                path: "${params.outdir}/intermediates/remove_redundancy/merge_families/generate_families_iteratively",
                mode: params.publish_dir_mode,
                enabled: params.save_intermediates,
                pattern: "*/*.*",
                saveAs: { filename -> filename ? "${meta.id}/${filename}" : null }
            ]
        ]
    }

    withName: 'HHSUITE_REFORMAT_SEED' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag        = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/seed_msa/raw/mgnifam/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HHSUITE_REFORMAT_FULL' {
        // Only a stepping stone to the family member fasta below; the Stockholm full MSA
        // it reformats is already published by MGNIFAM_GENERATEFAMILIES.
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag        = { "${meta.id}_${meta.chunk}" }
        publishDir = [ enabled: false ]
    }

    withName: 'SEQKIT_SEQ_ITERATIVE_MSA_TO_FASTA' {
        ext.args   = "--remove-gaps"
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag        = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/fasta/mgnifam_family_members/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'IDENTIFY_REDUNDANT_FAMS' {
        ext.args   = { [
            params.family_redundancy_removal == 'none' ? "--skip_family_redundancy_removal" : '',
            params.family_redundancy_removal == 'created_only' ? "--skip_updated_family_redundancy_removal" : '',
            // a merge rebuilds the HMM, so --skip_update_refinement keeps updated families out of merging
            params.family_merging == 'created_only' || params.skip_update_refinement ? "--skip_updated_family_merging" : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/families/${meta.id}/redundancy/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POOL_SIMILAR_COMPONENTS' {
        publishDir = [
            path: { "${params.outdir}/families/${meta.id}/redundancy/" },
            mode: params.publish_dir_mode,
            pattern: "pooled_components.txt", // pooled_fam_ids.txt only feeds the family removal
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MERGE_SEEDS' {
        ext.prefix = { "${meta.merged_id}" }
        tag = { "${meta.merged_id}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/merge_families/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_NON_REDUNDANT_HMM' {
        publishDir = [
            path: { "${params.outdir}/intermediates/hmm/filtered/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_NON_REDUNDANT_SEED_MSA' {
        publishDir = [
            path: { "${params.outdir}/intermediates/seed_msa/filtered/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_NON_REDUNDANT_FULL_MSA' {
        publishDir = [
            path: { "${params.outdir}/intermediates/full_msa/filtered/hmmsearch/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_NON_REDUNDANT_FASTA' {
        publishDir = [
            path: { "${params.outdir}/intermediates/fasta/non_redundant_family_filtered/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REMOVE_REDUNDANT_SEQS' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/fasta/non_redundant_sequences_filtered/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HHSUITE_REFORMAT_FILTERED' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/full_msa/filtered/hhsuite_reformat/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HHSUITE_REFORMAT_RAW' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/intermediates/full_msa/raw/hhsuite_reformat/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:UPDATE_FAMILIES:REMOVE_REDUNDANT_SEQS' {
        publishDir = [ enabled: false ] // intermediate: the family fasta is published from the (trimmed) MSA rows
    }

    withName: 'NFCORE_PROTEINFAMILIES:PROTEINFAMILIES:CMAPLE' {
        ext.prefix = { "${meta.family}" }
        tag = { "${meta.id}_${meta.family}" }
        publishDir = [
            path: { "${params.outdir}/phylogeny/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_FAMILY_MEMBERS' {
        ext.prefix = { "${meta.id}_members" }
        publishDir = [
            path: { "${params.outdir}/families/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_FAMILY_REPS' {
        publishDir = [
            path: { "${params.outdir}/families/${meta.id}/" },
            mode: params.publish_dir_mode,
            pattern: "*_meta_mqc.csv", // the reps FASTA is published with the downstream samplesheet (main.nf)
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '(.*:)?REMOVE_REDUNDANCY:EXTRACT_FAMILY_REPS' {
        publishDir = [
            path: { "${params.outdir}/intermediates/remove_redundancy/family_reps/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:PROTEINFAMILIES:FIND_CONCATENATE_HMM_LIBRARY' {
        ext.prefix = { "${meta.id}.lib.gz" }
        publishDir = [
            path: { "${params.outdir}/families/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
